# Public settings for the Supabase browser client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local demo: Vite proxies /api/queue and /api/trigger/call to the collections API (calltrigger-api).
# Read only by the Vite server, never sent to the browser. Use the same TRIGGER_API_KEY as calltrigger-api.
COLLECTIONS_API_URL=http://127.0.0.1:8000
TRIGGER_API_KEY=

# Server-only Relay webhook. Configure in Vercel Environment Variables too.
CALL_WORKFLOW_URL=
CALL_WORKFLOW_TOKEN=

# Receipt parsing uses CALL_WORKFLOW_TOKEN as the Sarvam Document AI key.
# Optional fallback if using a separate document-processing key:
# SARVAM_API_KEY=
